# LLM / Embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=researchgraph_chunks
BM25_INDEX_PATH=artifacts/bm25_index.pkl
VECTOR_SIZE=1024
DISTANCE_METRIC=cosine
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DENSE_TOP_K=20
SPARSE_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
MAX_HOPS=4

# Runtime
LOG_LEVEL=INFO
